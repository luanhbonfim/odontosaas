# ==========================================================================
# OdontoSaaS — .gitignore
# ==========================================================================

# --- Segredos / ambiente ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtualenv ---
.venv/
venv/
env/
ENV/

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
/static_root/

# --- Testes / cobertura ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/
.ruff_cache/

# --- Docker ---
# (volumes locais são declarados no compose; dados persistidos ficam fora do repo)
*.pid

# --- IDEs / SO ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Celery ---
celerybeat-schedule
celerybeat.pid
