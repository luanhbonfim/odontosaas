# ==========================================================================
# OdontoSaaS — Exemplo de variáveis de ambiente
# Copie para `.env` e ajuste os valores. NUNCA versione o `.env` real.
#   cp .env.example .env
# ==========================================================================

# --------------------------------------------------------------------------
# Django
# --------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Domínio wildcard base do SaaS (subdomínio = tenant)
DJANGO_BASE_DOMAIN=localhost

# Chave Fernet para criptografar dados sensíveis (tokens Google).
# Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=7bfL4XTjSO_rOvwylRpwinUaaB-e2N_Q4mQG2eV8-68=

# --------------------------------------------------------------------------
# PostgreSQL 16
# --------------------------------------------------------------------------
POSTGRES_DB=odonto
POSTGRES_USER=odonto
POSTGRES_PASSWORD=odonto_senha_local
POSTGRES_HOST=db
POSTGRES_PORT=5432
# django-tenants usa o engine específico; a URL abaixo é montada pelo settings
DATABASE_URL=postgres://odonto:odonto_senha_local@db:5432/odonto

# --------------------------------------------------------------------------
# Redis / Celery
# --------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --------------------------------------------------------------------------
# Google Calendar (OAuth2)
# --------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integracoes/google/callback

# --------------------------------------------------------------------------
# WAHA — WhatsApp HTTP API (tier CORE, 100% gratuito)
# --------------------------------------------------------------------------

# --- (A) Lidas pela APLICAÇÃO DJANGO ao chamar o WAHA ---
# URL interna do container (nome do serviço na rede do docker-compose)
WAHA_API_URL=http://waha:3000
# Porta publicada no host (usada pelo docker-compose: ${WAHA_PORT:-3000})
WAHA_PORT=3000
# URL pública/interna do webhook do Django (recebe as respostas do paciente)
WAHA_WEBHOOK_URL=http://web:8000/notificacoes/whatsapp/webhook

# --- (B) Lidas pelo CONTAINER do WAHA ---
# Chave de API que protege os endpoints do WAHA (header X-Api-Key).
# É a MESMA usada pela aplicação Django acima. Em produção, gere uma chave forte.
WAHA_API_KEY=troque-esta-api-key
# Engine leve sem navegador (recomendada). Alternativa ainda mais leve: GOWS.
WHATSAPP_DEFAULT_ENGINE=NOWEB
# Webhook global do WAHA e eventos de interesse (mensagens recebidas).
WHATSAPP_HOOK_URL=http://web:8000/notificacoes/whatsapp/webhook
WHATSAPP_HOOK_EVENTS=message
# Pasta de armazenamento das sessões (montada como volume no compose).
WAHA_LOCAL_STORE_BASE_DIR=/app/.sessions

# Credenciais do Dashboard e do Swagger do WAHA. Se não forem fixadas, o WAHA
# gera novas a cada start (inviável para uso estável). Troque em produção.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha-dashboard
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=troque-esta-senha-swagger
