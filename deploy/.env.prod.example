# ==========================================================================
# OdontoSaaS — .env de PRODUÇÃO (EXEMPLO). Copie para a RAIZ como `.env`:
#     cp deploy/.env.prod.example .env
# e preencha TODOS os segredos. NUNCA versione o .env real no git.
#
# Gerar segredos fortes:
#   DJANGO_SECRET_KEY : python -c "import secrets;print(secrets.token_urlsafe(64))"
#   FIELD_ENCRYPTION_KEY (Fernet):
#       python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#   Senhas (Postgres/WAHA): openssl rand -base64 32
# ==========================================================================

# ---- Domínio / HTTPS (Caddy) ----
# Subdomínio(s) atendidos pelo Caddy (SPA + proxy /api). Vários: separe por espaço.
# INCLUA aqui o subdomínio do painel Vendor (VENDOR_ADMIN_HOST) para o Caddy servi-lo.
# Ex.: SITE_ADDRESS=clinica.seudominio.com.br ops-troque.seudominio.com.br
SITE_ADDRESS=clinica.seudominio.com.br
# E-mail para o Let's Encrypt (avisos de expiração/segurança).
ACME_EMAIL=voce@seudominio.com.br

# ---- Painel Vendor Admin (escondido) ----
# Subdomínio DEDICADO e NÃO ÓBVIO do painel; o comando `bootstrap_vendor` mapeia
# este host para o schema public. DEVE também constar em SITE_ADDRESS acima.
# (Crie o registro DNS A desse subdomínio apontando para a VPS.)
VENDOR_ADMIN_HOST=ops-troque-aleatorio.seudominio.com.br
# Caminho secreto do painel dentro do SPA (embutido no build do frontend).
# Deixe /plataforma-admin para o default, ou troque por algo secreto, ex.: /painel-x7k2z9
VENDOR_ADMIN_SECRET_PATH=/plataforma-admin

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=TROQUE-por-um-segredo-forte
# Ponto na frente casa TODOS os subdomínios de clínica de uma vez.
DJANGO_ALLOWED_HOSTS=.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.seudominio.com.br
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=INFO
# Fernet — criptografa tokens do Google no banco. GERE UMA NOVA (não use a de dev).
FIELD_ENCRYPTION_KEY=TROQUE-por-uma-chave-fernet-nova

# ---- Banco de dados (Postgres) ----
POSTGRES_DB=odonto
POSTGRES_USER=odonto
POSTGRES_PASSWORD=TROQUE-senha-forte-do-banco
# A app lê o banco por esta URL (host = nome do serviço "db" na rede Docker).
DATABASE_URL=postgres://odonto:TROQUE-senha-forte-do-banco@db:5432/odonto

# ---- Redis (broker/cache do Celery) ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# ---- Google Calendar (OAuth2) ----
# Crie as credenciais no Google Cloud e aponte o redirect para o domínio real.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://clinica.seudominio.com.br/integracoes/google/callback
# Vazio em produção (same-origin): o callback volta pro próprio domínio.
GOOGLE_OAUTH_FRONTEND_URL=
# Vazio = usa o domínio primário do tenant para montar links (ex.: confirmação).
APP_BASE_URL=

# ---- WAHA (WhatsApp HTTP API) ----
WAHA_IMAGE=devlikeapro/waha:latest
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=TROQUE-api-key-forte-do-waha
WHATSAPP_DEFAULT_ENGINE=GOWS
WHATSAPP_HOOK_EVENTS=message
# Segredo do webhook INBOUND (WAHA -> Django). OBRIGATÓRIO em produção: sem ele,
# um terceiro poderia forjar respostas e confirmar/cancelar consultas de qualquer
# clínica (o endpoint é público via proxy). Gere: openssl rand -hex 32
# NÃO defina WHATSAPP_HOOK_URL manualmente: o docker-compose monta a URL do hook
# já com ?token=${WAHA_WEBHOOK_TOKEN}, garantindo que WAHA e Django usem o mesmo segredo.
WAHA_WEBHOOK_TOKEN=TROQUE-token-forte-do-webhook-waha
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=TROQUE-senha-do-dashboard-waha
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=TROQUE-senha-do-swagger-waha

# ---- Observabilidade (opcional) ----
# Preencha com o DSN do Sentry para monitorar erros em produção.
SENTRY_DSN=

# ---- Backup ----
# Pasta no servidor onde os dumps do Postgres serão gravados.
BACKUP_DIR=/opt/odonto/backups
RETENTION_DAYS=14

# ---- Database Studio (Vendor Admin) ----
# Senha do role PostgreSQL somente-leitura dedicado (`odonto_studio_ro`).
# OBRIGATÓRIO em produção. NUNCA use a mesma senha do usuário odonto principal.
# Gere uma senha forte com: openssl rand -base64 32
STUDIO_RO_PASSWORD=TROQUE-senha-forte-do-role-studio-ro

# ---- Operador Master do Vendor Admin ----
# Conta is_superuser semeada em TODOS os schemas — é a credencial que loga no painel
# do Vendor Admin. OBRIGATÓRIO em produção (sem ela o provisionamento falha de propósito,
# para nunca cair no default de desenvolvimento). Gere: openssl rand -base64 32
MASTER_ADMIN_EMAIL=admin@proclinica.cloud
MASTER_ADMIN_PASSWORD=TROQUE-senha-forte-do-operador-master

